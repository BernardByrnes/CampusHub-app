# Required for database-backed features and Drizzle commands.
# This is a placeholder only; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional separate migration/DDL principal. Runtime application access uses
# DATABASE_URL and must not use the migration principal in production.
DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DATABASE

# External A6 audit-integrity secret boundary; never commit a real key.
AUDIT_INTEGRITY_KEY_VERSION=1
AUDIT_INTEGRITY_KEY=BASE64_ENCODED_32_BYTE_SECRET

# Next.js supplies NODE_ENV for normal commands; this helps standalone tooling.
NODE_ENV=development
